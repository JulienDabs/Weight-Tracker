generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Weight {
  weight           Float?
  userId           String
  active           Int?
  bloodPressure    String?
  bmi              Float
  chest            Int?
  createdAt        DateTime @default(now())
  heartRate        Int?
  hip              Int?
  projectedBmi     Float?
  thigh            Int?
  waist            Int?
  weeksToReachGoal Int?
  weightGoal       Float?
  id               Int      @id @default(autoincrement())
}
