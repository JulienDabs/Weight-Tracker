generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id            Int       @id @default(autoincrement())
  firstname     String?
  lastname      String?
  email         String    @unique
  password      String
  currentWeight Float?
  height        Int?
  bloodPressure String?
  weightGoal    Float?
  isVerified    Boolean   @default(false)
  gender        Gender?   @default(MALE)
  birthday      DateTime?
  currentActive Int?
  currentBmi    Float?
  currentWeeksToReachGoal Int?
}

enum Gender {
  MALE
  FEMALE
}
